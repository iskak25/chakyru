rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountRole == 'admin';
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'dastaniskak0302@gmail.com',
          'iskak2512@gmail.com'
        ];
    }

    function admin() {
      return isAdminUser() || isBootstrapAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.accountRole == 'user';
      allow update: if signedIn() && (
        admin()
        || (
          request.auth.uid == uid
          && request.resource.data.accountRole == resource.data.accountRole
          && request.resource.data.plan == resource.data.plan
          && request.resource.data.get('templates', []) == resource.data.get('templates', [])
        )
      );

      match /templateAccess/{templateId} {
        allow read: if signedIn() && (request.auth.uid == uid || admin());
        allow write: if false;
      }
    }

    match /payments/{id} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow create, update, delete: if false;
    }

    match /purchases/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId
        || request.auth.uid == resource.data.uid
        || admin()
      );
      allow create, update, delete: if false;
    }

    match /userTemplatePrices/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin());
      allow write: if admin();
    }

    match /invitations/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /catalog/payments {
      allow read, write: if admin();
    }

    match /catalog/{docId} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
