# Firebase Auth (Google). Copy to .env.local from Firebase Console.
# Project settings → Your apps → Web app.
# Authentication → Sign-in method → Google (enable)
# Authentication → Settings → Authorized domains: localhost
#
# Google Cloud Console → Credentials → OAuth 2.0 Client
#   Authorized JavaScript origins:  http://localhost:3000
#   Authorized redirect URIs:       http://localhost:3000/login
# Open http://localhost:3000 (not https://).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Comma-separated Google emails. First login as these becomes admin.
NEXT_PUBLIC_ADMIN_EMAILS=

# Optional stock photos (Canva-like Elements). Free keys:
# https://www.pexels.com/api/  and  https://unsplash.com/developers
# Without a key the editor uses Openverse (Creative Commons).
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Finik payments (https://www.finik.kg/for-developers/)
# Can also be filled in Admin → Settings.
# 1. openssl genrsa -out finik_private.pem 2048
# 2. openssl rsa -in finik_private.pem -pubout > finik_public.pem
# 3. Upload finik_public.pem in Finik cabinet → Keys → Web client
# 4. Put API key, account id, and private PEM below (or in admin).
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
FINIK_PRIVATE_KEY=
FINIK_MCC=5999
FINIK_BETA=1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin (webhook writes plan). JSON of a service account key.
FIREBASE_SERVICE_ACCOUNT=
